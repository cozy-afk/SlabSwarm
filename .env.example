# ==============================================================================
# SlabGraph Self-Hosted Production Configuration
# Copy this file to .env on your server and populate the secrets you use.
# All API keys, webhook URLs, and passcodes stay strictly server-side.
# ==============================================================================

# Server Port (defaults to 3000)
PORT=3000

# Self-Hosted Persistent Graph & Portfolio Store (atomic JSON store on disk)
SLABGRAPH_DATA_DIR="./data"

# Optional Self-Hosted Operator Passcode (locks write endpoints behind Bearer login)
# Leave blank to run open locally or claim a passcode via the in-app Setup Guide.
SLABGRAPH_ADMIN_PASSCODE=
# Recommended on production servers: random 32+ byte hex secret so sessions survive restarts
SLABGRAPH_SESSION_SECRET=

# Task 16: hard-attribute match confidence floor in (0, 1]; default 0.75.
# Listing-title matches below this floor are quarantined for internal QA review
# and never enter FMV or canonical price observations. Invalid values fall back.
SLABGRAPH_MATCH_CONFIDENCE_FLOOR="0.75"

# Primary Server-Side LLM Provider & Hybrid Vector Embeddings
# Server LLM uses OpenCode Go through the app's OpenAI-compatible provider below.
# Gemini is optional here (only needed for the vector embedding index).
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Default Swarm Routing Provider (gemini | hermes | openai | anthropic | ollama)
LLM_DEFAULT_PROVIDER="openai"

# Live Alert Dispatch Channels (Layer 3 Alerts -> Discord / Telegram / Hermes)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hermes Agent (Nous Research) Bidirectional Gateway Integration
# Expose your local Hermes gateway (:8642 API / :8644 Webhook) via TLS tunnel or private host
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL="hermes-agent"
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
# Optional shared Bearer token required when Hermes calls /api/hermes/tools/execute
HERMES_BRIDGE_TOKEN=

# Server LLM: OpenCode Go (OpenAI-compatible). Key comes from opencode.ai console.
OPENAI_API_KEY=
OPENAI_BASE_URL="https://opencode.ai/zen/go/v1"
OPENAI_MODEL="hy4-flash-free"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

OLLAMA_BASE_URL=
OLLAMA_MODEL="llama3.1:8b"

# Public URL where SlabGraph is hosted (used in Hermes/webhook integration snippets)
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------------------
# Canonical data store (PostgreSQL 17, internal Docker network only)
# The database service is never published to the host. These are non-secret
# keys; set POSTGRES_PASSWORD in the server's private .env only.
# ------------------------------------------------------------------------------
POSTGRES_DB=slabswarm
POSTGRES_USER=slabswarm
POSTGRES_PORT=5432
# Internal Docker network DSN. Use the password configured in the host .env.
DATABASE_URL=postgresql://slabswarm:CHANGE_ME@slabswarm-db:5432/slabswarm

# Optional: TCG API key for scripts/tcgapi_seed.py (https://tcgapi.dev)
# Keep the real value in the host .env only; never commit it.
TCGAPI_KEY=
# Enable the credit-bounded live harvest (default false). Server-side only.
TCGAPI_ENABLED=false
# Maximum TCGAPIs credits a single harvest may spend (default 60).
TCGAPI_HARVEST_CREDIT_BUDGET=60
