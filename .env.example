# ==============================================================================
# SlabGraph Self-Hosted Production Configuration
# Copy this file to .env on your server and populate the secrets you use.
# All API keys, webhook URLs, and passcodes stay strictly server-side.
# ==============================================================================

# Server Port (defaults to 3000)
PORT=3000

# Self-Hosted Persistent Graph & Portfolio Store (atomic JSON store on disk)
SLABGRAPH_DATA_DIR="./data"

# Optional Self-Hosted Operator Passcode (locks write endpoints behind Bearer login)
# Leave blank to run open locally or claim a passcode via the in-app Setup Guide.
SLABGRAPH_ADMIN_PASSCODE=
# Recommended on production servers: random 32+ byte hex secret so sessions survive restarts
SLABGRAPH_SESSION_SECRET=

# Primary Server-Side LLM Provider & Hybrid Vector Embeddings
GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_MODEL="gemini-4-hydrogen"
GEMINI_EMBEDDING_MODEL="gemini-embedding-2"

# Default Swarm Routing Provider (gemini | hermes | openai | anthropic | ollama)
LLM_DEFAULT_PROVIDER="gemini"

# Live Alert Dispatch Channels (Layer 3 Alerts -> Discord / Telegram / Hermes)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Hermes Agent (Nous Research) Bidirectional Gateway Integration
# Expose your local Hermes gateway (:8642 API / :8644 Webhook) via TLS tunnel or private host
HERMES_API_URL=
HERMES_API_KEY=
HERMES_MODEL="hermes-agent"
HERMES_WEBHOOK_URL=
HERMES_WEBHOOK_SECRET=
# Optional shared Bearer token required when Hermes calls /api/hermes/tools/execute
HERMES_BRIDGE_TOKEN=

# Optional Pluggable LLM Providers
OPENAI_API_KEY=
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL="claude-3-5-sonnet-latest"

OLLAMA_BASE_URL=
OLLAMA_MODEL="llama3.1:8b"

# Public URL where SlabGraph is hosted (used in Hermes/webhook integration snippets)
APP_URL="MY_APP_URL"
