{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node server.ts",
    "test": "tsx --test tests/*.test.ts tests/benchmarks/*.test.ts",
    "benchmark": "tsx --test tests/benchmarks/*.test.ts",
    "db:generate": "drizzle-kit generate --config server/db/drizzle.config.ts",
    "db:migrate": "tsx server/db/migrate.ts",
    "db:studio": "drizzle-kit studio --config server/db/drizzle.config.ts",
    "db:backfill": "tsx scripts/backfill-json.ts",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@google/genai": "^3.6.1",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.4",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "pg": "8.23.1",
    "recharts": "^3.11.0",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "0.31.11",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
